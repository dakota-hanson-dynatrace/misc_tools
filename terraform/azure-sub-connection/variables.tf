        microsoft_eventgrid.systemtopics_essential/essentialplus/autodiscovery
        microsoft_notificationhubs.namespaces.notificationhubs_essential/essentialplus/autodiscovery
        microsoft_relay.namespaces_essential/essentialplus/autodiscovery
        microsoft_signalrservice.signalr_essential/autodiscovery
      Key Vault:
        microsoft_keyvault.vaults_essential/autodiscovery
      IoT:
        microsoft_devices.iothubs_essential/essentialplus/autodiscovery
        microsoft_devices.provisioningservices_essential/autodiscovery
        microsoft_iotcentral.iotapps_essential/autodiscovery
      Analytics:
        microsoft_datafactory.factories_essential/essentialplus/autodiscovery
