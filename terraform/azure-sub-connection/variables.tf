# ===========================================================================
# Dynatrace environment
# ---------------------------------------------------------------------------
# The Dynatrace provider authenticates via DT_* environment variables (see
# providers.tf). dt_env_url is still needed here because it forms the audience
# of the Azure federated credential.
# ===========================================================================

variable "dt_env_url" {
  description = "Full Dynatrace environment URL (e.g., https://<env-id>.apps.dynatrace.com)"
  type        = string

  validation {
    condition     = can(regex("^https://[a-zA-Z0-9.\\-]+\\.dynatrace\\.com$", var.dt_env_url))
    error_message = "dt_env_url must be a valid Dynatrace SaaS URL, e.g. https://abc123.apps.dynatrace.com."
  }
}

variable "dynatrace_token_issuer" {
  description = <<-EOT
    OIDC issuer Azure trusts for the federated credential. This is the token
    issuer for your Dynatrace environment. Only used when
    auth_type = "federatedIdentityCredential".
  EOT
  type        = string
  default     = "https://token.dynatrace.com"
}

# ===========================================================================
# Connection identity
# ===========================================================================

variable "connection_name" {
  description = "Human-readable name for this Azure connection (used as the connection and monitoring config description)"
  type        = string

  validation {
    condition     = can(regex("^[A-Za-z][A-Za-z0-9-]*$", var.connection_name))
    error_message = "connection_name must start with a letter and contain only letters, numbers, and hyphens (no spaces or underscores) — matches the Dynatrace API constraint."
  }
}

variable "app_display_name" {
  description = "Display name for the Azure AD app registration created for Dynatrace monitoring"
  type        = string
  default     = "Dynatrace-Monitoring"
}

# ===========================================================================
# Authentication
# ===========================================================================

variable "auth_type" {
  description = <<-EOT
    How Dynatrace authenticates as the Azure service principal.
      federatedIdentityCredential — passwordless (recommended). Azure trusts a
        Dynatrace-issued OIDC token bound to the connection ID; no secret stored.
      clientSecret — a client secret generated by Terraform and stored in the
        Dynatrace connection object.
  EOT
  type        = string
  default     = "federatedIdentityCredential"

  validation {
    condition     = contains(["federatedIdentityCredential", "clientSecret"], var.auth_type)
    error_message = "auth_type must be either \"federatedIdentityCredential\" or \"clientSecret\"."
  }
}

# ===========================================================================
# Azure deployment
# ===========================================================================

variable "tenant_id" {
  description = "Azure tenant (directory) ID — a GUID"
  type        = string

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", var.tenant_id))
    error_message = "tenant_id must be a valid GUID, e.g. 00000000-0000-0000-0000-000000000000."
  }
}

variable "subscription_id" {
  description = "Azure subscription ID to monitor and scope the Monitoring Reader role assignment to — a GUID"
  type        = string

  validation {
    condition     = can(regex("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", var.subscription_id))
    error_message = "subscription_id must be a valid GUID, e.g. 00000000-0000-0000-0000-000000000000."
  }
}

variable "monitored_locations" {
  description = "List of Azure regions (location names) Dynatrace will monitor, e.g. [\"eastus\", \"westeurope\"]"
  type        = list(string)

  validation {
    condition     = length(var.monitored_locations) > 0
    error_message = "At least one monitored location is required."
  }

  validation {
    condition     = alltrue([for l in var.monitored_locations : can(regex("^[a-z0-9]+$", l))])
    error_message = "Each monitored_location must be a lowercase Azure region name with no spaces, e.g. eastus or westeurope."
  }
}

# ===========================================================================
# Monitoring configuration
# ===========================================================================

variable "monitoring_config_scope" {
  description = <<-EOT
    Scope for the Dynatrace monitoring configuration.
    "integration-azure" is the correct value for da-azure connections.
    Override only if your Dynatrace environment requires a different scope.
  EOT
  type        = string
  default     = "integration-azure"
}

variable "enable_log_forwarder" {
  description = <<-EOT
    Deploy the Azure Logs and Events forwarder infrastructure (resource group,
    Event Hub namespace, and two Event Hubs) in each monitored location, and
    grant the Dynatrace service principal the Azure Event Hubs Data Receiver
    role on each namespace. Dynatrace auto-discovers namespaces tagged with
    managed-by=dynatrace and pulls logs and events without custom code.
    Docs: https://docs.dynatrace.com/docs/ingest-from/microsoft-azure-services/ingest-telemetry/azure-logs-and-events
  EOT
  type        = bool
  default     = false
}

